# Copy to .env and replace every placeholder before deployment.
APP_PASSWORD=replace-with-a-long-random-password
APP_SECRET_KEY=replace-with-a-generated-session-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Docker Compose / Caddy hostname, without protocol, port or path.
DOMAIN=sync.example.com

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# The root URL handles the OAuth callback; the dedicated callback route is also supported.
STRAVA_REDIRECT_URI=https://sync.example.com/

# HTTPS deployments should use true. For local HTTP development only, use false.
COOKIE_SECURE=true
