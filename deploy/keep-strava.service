[Unit]
Description=Keep to Strava personal sync
After=network-online.target
Wants=network-online.target

[Service]
User=keep-strava
Group=keep-strava
WorkingDirectory=/srv/keep-strava
EnvironmentFile=/srv/keep-strava/.env
Environment=DATA_DIR=/srv/keep-strava/data
Environment=COOKIE_SECURE=true
ExecStart=/srv/keep-strava/.venv/bin/gunicorn --workers 1 --threads 8 --timeout 180 --bind 127.0.0.1:19180 app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/keep-strava/data
UMask=0077

[Install]
WantedBy=multi-user.target
